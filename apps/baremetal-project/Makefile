
# ============================================================
# Project: rp2040-ground-up
# Toolchain: GCC / MinGW-w64
# Build system: GNU Make
#
# All C and Assembly files are compiled into object files.
# All object files are linked directly into the executable.
# No static library or archiver is used.
# ============================================================


# ------------------------------------------------------------
# 1. Toolchain
# ------------------------------------------------------------

CC      := gcc

# Compiler flags
CFLAGS  := -std=c11 -Wall -Wextra -Wpedantic

# Assembly compiler flags
ASFLAGS :=

# Linker flags
LDFLAGS :=

# Additional libraries
LDLIBS  :=


# ------------------------------------------------------------
# 2. Project configuration
# ------------------------------------------------------------

TARGET_NAME := rp2040
TARGET      := build/$(TARGET_NAME).exe

BUILD_DIR   := build
OBJ_DIR     := $(BUILD_DIR)/obj


# ------------------------------------------------------------
# 3. Include directories
# ------------------------------------------------------------

# Add all directories containing header files here.
# Add another directory whenever you introduce a new header folder.

INCLUDE_DIRS := \
    include \
    CMSIS/Core

# Convert directories into GCC -I arguments.
# Example: include CMSIS/Core becomes
#          -Iinclude -ICMSIS/Core

INCLUDES := $(addprefix -I,$(INCLUDE_DIRS))


# ------------------------------------------------------------
# 4. Source directories
# ------------------------------------------------------------

# Add directories containing C and Assembly source files.

SOURCE_DIRS := \
    . \
    src \
    startup

# Discover C source files.
C_SOURCES := $(foreach dir,$(SOURCE_DIRS),\
             $(wildcard $(dir)/*.c))

# Discover preprocessed Assembly source files (.S).
ASM_SOURCES := $(foreach dir,$(SOURCE_DIRS),\
               $(wildcard $(dir)/*.S))

# Combine all source files.
ALL_SOURCES := $(C_SOURCES) $(ASM_SOURCES)


# ------------------------------------------------------------
# 5. Generate object file paths
# ------------------------------------------------------------

# Preserve the original directory structure.
#
# main.c          -> build/obj/main.o
# src/gpio.c      -> build/obj/src/gpio.o
# startup/startup.S -> build/obj/startup/startup.o

OBJECTS := $(patsubst %.c,$(OBJ_DIR)/%.o,$(C_SOURCES)) \
           $(patsubst %.S,$(OBJ_DIR)/%.o,$(ASM_SOURCES))

# Dependency files generated by GCC.
DEP_FILES := $(OBJECTS:.o=.d)


# ------------------------------------------------------------
# 6. Default target
# ------------------------------------------------------------

.PHONY: all

all: $(TARGET)


# ------------------------------------------------------------
# 7. Compile C source files
# ------------------------------------------------------------

# Generic rule for compiling any C source file.

$(OBJ_DIR)/%.o: %.c
	@if not exist "$(@D)" mkdir "$(@D)"
	$(CC) $(CFLAGS) $(INCLUDES) -MMD -MP -MF "$(@:.o=.d)" -c $< -o $@


# ------------------------------------------------------------
# 8. Compile Assembly source files
# ------------------------------------------------------------

# GCC compiles .S files and runs the C preprocessor first.
# This is useful when Assembly needs macros and header definitions.

$(OBJ_DIR)/%.o: %.S
	@if not exist "$(@D)" mkdir "$(@D)"
	$(CC) $(ASFLAGS) $(INCLUDES) -MMD -MP -MF "$(@:.o=.d)" -c $< -o $@


# ------------------------------------------------------------
# 9. Link all object files
# ------------------------------------------------------------

$(TARGET): $(OBJECTS)
	@if not exist "$(BUILD_DIR)" mkdir "$(BUILD_DIR)"
	$(CC) $(LDFLAGS) -o $@ $(OBJECTS) $(LDLIBS)


# ------------------------------------------------------------
# 10. Run application
# ------------------------------------------------------------

.PHONY: run

run: $(TARGET)
	$(TARGET)


# ------------------------------------------------------------
# 11. Clean build artifacts
# ------------------------------------------------------------

.PHONY: clean

clean:
	@if exist "$(BUILD_DIR)" rmdir /S /Q "$(BUILD_DIR)"


# ------------------------------------------------------------
# 12. Rebuild
# ------------------------------------------------------------

.PHONY: rebuild

rebuild: clean all


# ------------------------------------------------------------
# 13. Include generated dependencies
# ------------------------------------------------------------

-include $(DEP_FILES)
