
# ============================================================
# Project: template_project
# Build system: GNU Make
# Compiler: MinGW-w64 GCC
# Platform: Windows
# ============================================================


# ------------------------------------------------------------
# 1. Toolchain configuration
# ------------------------------------------------------------

CC      := gcc
AR      := ar

# Compiler and linker flags
CFLAGS  := -std=c11 -Wall -Wextra -Wpedantic -Iinclude
LDFLAGS :=
LDLIBS  :=


# ------------------------------------------------------------
# 2. Project configuration
# ------------------------------------------------------------

TARGET_NAME := myapp

# Directories
SRC_DIR     := src
INC_DIR     := include
BUILD_DIR   := build
OBJ_DIR     := $(BUILD_DIR)/obj
LIB_DIR     := $(BUILD_DIR)/lib

# Application source
MAIN_SRC    := $(SRC_DIR)/main.c

# Static library
LIB_NAME    := libmylib.a
LIBRARY     := $(LIB_DIR)/$(LIB_NAME)

# Final executable
TARGET      := $(BUILD_DIR)/$(TARGET_NAME).exe


# ------------------------------------------------------------
# 3. Source and object file discovery
# ------------------------------------------------------------

# Automatically discover all C source files in src/
LIB_SOURCES := $(wildcard $(SRC_DIR)/*.c)

# Generate corresponding object file paths
LIB_OBJECTS := $(patsubst $(SRC_DIR)/%.c, \
                $(OBJ_DIR)/%.o, $(LIB_SOURCES))

# Main application object file
MAIN_OBJ    := $(OBJ_DIR)/main.o

# All object files
OBJECTS     := $(MAIN_OBJ) $(LIB_OBJECTS)

# Dependency files generated by GCC
DEP_FILES   := $(OBJECTS:.o=.d)


# ------------------------------------------------------------
# 4. Default target
# ------------------------------------------------------------

# Running 'make' builds the complete application
.PHONY: all

all: $(TARGET)


# ------------------------------------------------------------
# 5. Compile main.c
# ------------------------------------------------------------

$(MAIN_OBJ): $(MAIN_SRC)
	@if not exist "$(OBJ_DIR)" mkdir "$(OBJ_DIR)"
	$(CC) $(CFLAGS) -MMD -MP -MF "$(@:.o=.d)" -c $< -o $@


# ------------------------------------------------------------
# 6. Compile static library source files
# ------------------------------------------------------------

# Pattern rule:
# src/example.c -> build/obj/example.o

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.c
	@if not exist "$(OBJ_DIR)" mkdir "$(OBJ_DIR)"
	$(CC) $(CFLAGS) -MMD -MP -MF "$(@:.o=.d)" -c $< -o $@


# ------------------------------------------------------------
# 7. Create static library
# ------------------------------------------------------------

# Archive all library object files into a static library.
# 'ar rcs' creates or updates the archive.

$(LIBRARY): $(LIB_OBJECTS)
	@if not exist "$(LIB_DIR)" mkdir "$(LIB_DIR)"
	$(AR) rcs $@ $(LIB_OBJECTS)


# ------------------------------------------------------------
# 8. Link final executable
# ------------------------------------------------------------

# Link main.o with the static library.
# Static library is placed after main.o to resolve symbols.

$(TARGET): $(MAIN_OBJ) $(LIBRARY)
	@if not exist "$(BUILD_DIR)" mkdir "$(BUILD_DIR)"
	$(CC) $(LDFLAGS) -o $@ $(MAIN_OBJ) $(LIBRARY) $(LDLIBS)


# ------------------------------------------------------------
# 9. Run application
# ------------------------------------------------------------

.PHONY: run

run: $(TARGET)
	$(TARGET)


# ------------------------------------------------------------
# 10. Clean build artifacts
# ------------------------------------------------------------

.PHONY: clean

clean:
	@if exist "$(BUILD_DIR)" rmdir /S /Q "$(BUILD_DIR)"


# ------------------------------------------------------------
# 11. Rebuild everything
# ------------------------------------------------------------

.PHONY: rebuild

rebuild: clean all


# ------------------------------------------------------------
# 12. Include automatically generated dependencies
# ------------------------------------------------------------

# GCC generates .d files containing header dependencies.
# This ensures that changing a header triggers recompilation.

-include $(DEP_FILES)
